#!/usr/bin/env sh

# Whole-repository checks that take seconds, once per push: the hooks are
# armed, and the tree typechecks. No suite runs here, after Kata and Kumiko:
# each kept its unit suite in pre-push "until it passed a minute", and it was
# still there at thousands of tests, so every push cost minutes and a flaky
# spec refused pushes it had nothing to do with. The suites, with their 38%
# coverage floor, run per change (the specs you touched), and whole on every
# `main` head by the CI runner. See doc/TESTING.md, "Three tiers".
#
# Skip flags (set to any non-empty value):
#   SKIP_HOOKS SKIP_TYPECHECK SKIP_HAJIME SKIP_ALL

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

step() { printf "\n${CYAN}${BOLD}> %s${RESET}\n" "$1"; }
ok() { printf "${GREEN}[ok] %s${RESET}\n" "$1"; }
skip() { printf "${YELLOW}[skip] %s${RESET}\n" "$1"; }
fail() { printf "${RED}[fail] %s${RESET}\n" "$1"; }

if [ -n "$SKIP_ALL" ]; then
	printf "${YELLOW}${BOLD}pre-push: SKIP_ALL set - skipping every check${RESET}\n"
	exit 0
fi

printf "${BOLD}pre-push: running repository checks${RESET}\n"
printf "${DIM}  skip flags: SKIP_HOOKS SKIP_TYPECHECK SKIP_HAJIME SKIP_ALL${RESET}\n"

# `.husky/_` is gitignored, so `git worktree add` never creates it and git then
# runs no hook at all, silently. Reaching this file means pre-push is installed;
# what this step catches is the half case where another shim is missing.
if [ -n "$SKIP_HOOKS" ]; then
	skip "hook arming"
else
	step "hook arming"
	if ! yarn run --silent hooks:check; then
		fail "git hooks are not armed for this checkout"
		exit 1
	fi
	ok "hooks armed"
fi

if [ -n "$SKIP_TYPECHECK" ]; then
	skip "typecheck"
else
	step "typecheck"
	# `yarn run check`, never `yarn check`: yarn 1's builtin `check` verifies
	# node_modules and exits 0 without typechecking anything.
	if ! yarn run check; then
		fail "typecheck failed"
		exit 1
	fi
	ok "typecheck passed"
fi

# The house rules hajime holds (~/projects/hajime, doc/DESIGN.md): briefs,
# bare yarn calls, what git tracks, the floor's settings. Offline and seconds,
# so it runs on every push instead of when somebody remembers to. A machine
# without hajime skips rather than fails, like the agent-docs budget.
if [ -n "$SKIP_HAJIME" ]; then
	skip "house rules"
elif command -v hajime >/dev/null 2>&1; then
	step "house rules (hajime check)"
	if ! hajime check --offline; then
		fail "a house rule is broken: hajime apply fixes what it can, the rest says what to do"
		exit 1
	fi
	ok "house rules hold"
else
	skip "hajime not installed"
fi

printf "\n${GREEN}${BOLD}[ok] pre-push checks passed${RESET}\n"
