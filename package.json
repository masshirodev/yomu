{
	"name": "yomu",
	"license": "MIT",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 42139",
		"build": "vite build",
		"preview": "vite preview",
		"postinstall": "node node_modules/kotoba/scripts/sync-dict.js static/dict || echo ''",
		"prepare": "svelte-kit sync || echo ''; husky || true",
		"check": "node scripts/hooks-armed.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"sync:dict": "node node_modules/kotoba/scripts/sync-dict.js static/dict",
		"build:dict": "node --max-old-space-size=2048 node_modules/kotoba/scripts/build-dict.js",
		"hooks:check": "node scripts/hooks-armed.mjs",
		"lint-staged": "lint-staged",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"test:all": "yarn run test:coverage && yarn run test:e2e"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@types/better-sqlite3": "^7.6.13",
		"better-sqlite3": "^12.11.1",
		"kotoba": "link:../kotoba"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.12"
	},
	"packageManager": "yarn@1.22.22",
	"engines": {
		"node": ">=24"
	}
}
